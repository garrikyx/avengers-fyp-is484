# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Agent
MAGIC_LOG_DIR=./logs
# Agent secrets (UBS-114; never in config/agent.yaml). A localhost-only
# setup falls back to dev values when these are unset.
MAGIC_TELEMETRY_ID_HASH_KEY=dev-only
MAGIC_TELEMETRY_PUBLISH_TOKEN=dev-local-token
MAGIC_TELEMETRY_CALLBACK_SECRET=dev-local-secret

# Teams alert notifications (UBS-120). Same value for the backend and the bot; the
# backend does not read .env, so export it in the backend's terminal too.
# MAGIC_TELEMETRY_TEAMS_NOTIFY_TOKEN=
# TEAMS_NOTIFY_STATE_PATH=.teams-state/conversation.json
# TEAMS_NOTIFY_CONVERSATION_ID=          # pin one group chat if the bot is in several
# TEAMS_NOTIFY_ALLOW_PERSONAL=true       # local Agents Playground only

# Teams bot (apps/teams; see apps/teams/README.md). Azure bot app registration:
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# TELEMETRY_BACKEND_URL=http://127.0.0.1:8080
